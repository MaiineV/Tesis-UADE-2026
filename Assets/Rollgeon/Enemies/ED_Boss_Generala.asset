  EntityId: boss.la_generala
  DisplayName: La Generala
  Description: "The house playing your own game. Five dice of her own on the table,
    the same combo sheet you use, and one hand per round. Her roll is public before
    it detonates: you see the five numbers and you know what is coming. Break a die
    and you erase a category \u2014 with four she cannot roll Generala, with three
    she loses Poker. Walking up to the table is not free: on odd turns the dice cup
    comes down around her."
  Portrait: {fileID: 0}
  WeaknessComboId: combo.generala
  WeaknessMultiplierOverride: 1.5
  BaseHP: 250
  BaseAttack: 40
  BaseHealStrength: 0
  BaseSpeed: 4
  MaxEnergy: 3
  BaseAttackRange: 1
  ExtraTiers: []
  VisualPrefab: {fileID: 8816966952657547766, guid: 1d91f0f914a935c4cb6d3767044294c2, type: 3}
  MinGoldDrop: 60
  MaxGoldDrop: 80
