  EntityId: boss.croupier
  DisplayName: The Croupier
  Description: "\"The house never chases.\" He backs away every turn and shoots from
    anywhere on the table for 10. Every other turn he lights a 3-tile-wide lane of
    fire that runs from him to the wall behind you. Crossing a burning tile costs
    6, once per tile. Starting your turn on one costs 18. A lane burns for 2 rounds
    \u2014 it clears just as the next one lights. Once the table has burned they
    last 3 and two lanes overlap. At 70% he padlocks one of your dice for the rest
    of the fight. At 50%, once, the whole table burns except the 3\xD73 he is standing
    in."
  Portrait: {fileID: -2011244216, guid: 20ce88debfdaa06459d18ed604643892, type: 3}
  WeaknessComboId: combo.pair
  WeaknessMultiplierOverride: 1.5
  BaseHP: 120
  BaseAttack: 20
  BaseHealStrength: 0
  BaseSpeed: 5
  MaxEnergy: 3
  BaseAttackRange: 1
  ExtraTiers: []
