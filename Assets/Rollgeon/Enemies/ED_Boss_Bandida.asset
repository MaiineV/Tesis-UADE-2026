  EntityId: boss.one_armed
  DisplayName: La Bandida
  Description: 'A three-reel slot machine bolted to the wall. It never chases you:
    it counts to the jackpot. Break any reel to cancel the count.'
  Portrait: {fileID: 21300000, guid: a82854fa343807a45a79990bcb5639f5, type: 3}
