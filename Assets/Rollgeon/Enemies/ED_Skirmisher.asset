  EntityId: enemy.skirmisher
  DisplayName: Skirmisher
  Description: 
  Portrait: {fileID: 2137510266, guid: 5854c90019d7bec45a7eae78e058123b, type: 3}
  Design:
    Archetype: 2
    Pattern: 2
    Timing: 1
    Notes: 'Skirmisher: dispara SOLO en diagonal exacta (|dx|==|dy|) a <=4 Chebyshev,
      instantaneo, sin telegraph. Si no esta en diagonal (incluido si el jugador
      queda adyacente ortogonal, pierde el ataque efectivo por diseno), se reposiciona
      buscando una diagonal a distancia 2 (AINode_MoveToDiagonal, mismo criterio
      hazard-aware y de distancia de camino real que el Sniper). Mismo modelo/animacion
      que ED_RangedEnemy, prefab propio recoloreado a gama roja/naranja.'
  WeaknessComboId: 
  WeaknessMultiplierOverride: 0
  Curse: {fileID: 0}
  BaseHP: 50
  BaseAttack: 12
  BaseHealStrength: 5
  BaseSpeed: 5
  MaxEnergy: 3
  BaseAttackRange: 4
  ExtraTiers: []
  VisualPrefab: {fileID: 8816966952657547766, guid: 28d76b52b76aa9a45baf8ce830ea2e17, type: 3}
  MinGoldDrop: 8
  MaxGoldDrop: 12
  IsFlying: 0
  IsBoss: 0
