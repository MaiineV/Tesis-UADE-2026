  EntityId: boss.cashier
  DisplayName: El Cajero
  Description: "Te tira lejos y te saca oro, y parte de esa plata cae al piso. La
    que no levant\xE1s a tiempo se pierde."
  Portrait: {fileID: 133841030, guid: 7354be46d5bce5b44ae3fc20ec0cb47f, type: 3}
  Design:
    Archetype: 1
    Pattern: 1
    Timing: 1
    Notes: "Mandoble y empuj\xF3n alternados a distancia 1, cada golpe deja monedas
      por la sala; fuera de alcance marca un 3\xD73 sobre el jugador y lo cobra al
      turno siguiente, plantado; caja fuerte; refuerzos (Comisi\xF3n)."
  WeaknessComboId: combo.full_house
  WeaknessMultiplierOverride: 1.5
  Curse: {fileID: 11400000, guid: 0e92b4d6bcb557b4684b8a969a2ace36, type: 2}
  BaseHP: 450
  BaseAttack: 20
  BaseHealStrength: 0
  BaseSpeed: 4
  MaxEnergy: 3
  BaseAttackRange: 1
