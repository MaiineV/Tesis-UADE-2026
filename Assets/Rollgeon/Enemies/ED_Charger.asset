  EntityId: enemy.charger
  DisplayName: Charger
  Description: 
  Portrait: {fileID: -1325774086, guid: afb0f04145bd30749bb686aea490fc8a, type: 3}
  Design:
    Archetype: 1
    Pattern: 3
    Timing: 2
    Notes: 'Charger: busca alinearse (rango 5), marca una carga con gesto de ''cargar''
      (anim Charge, se queda en el loop mientras espera). Turno siguiente: impacto
      (anim Attack->Hit) + recule (anim Hit->Recoil), reubicacion+empuje, o +50%
      dano si se bloquea. Adyacente desde el inicio del turno: melee reducido sin
      telegraph (anim AttackWeak).'
  WeaknessComboId: 
  WeaknessMultiplierOverride: 0
  Curse: {fileID: 0}
  BaseHP: 90
  BaseAttack: 20
  BaseHealStrength: 5
  BaseSpeed: 8
  MaxEnergy: 3
  BaseAttackRange: 5
  ExtraTiers: []
  VisualPrefab: {fileID: 2759895263432739200, guid: 1850e8217fe5ef54b88b2f940c9ba2a4, type: 3}
  MinGoldDrop: 3
  MaxGoldDrop: 5
  IsFlying: 0
  IsBoss: 0
