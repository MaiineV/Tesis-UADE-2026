  - m_Id: 12996722146967559
    m_Localized: Playing
    m_Metadata:
      m_Items: []
  - m_Id: 14619625939369984
    m_Localized: 'You zoomed! Now rotate the camera: hold the right button and drag
      the mouse.'
    m_Metadata:
      m_Items: []
  - m_Id: 14619625981313024
    m_Localized: 'You rotated the camera! Now try the zoom: use the mouse wheel to
      zoom in or out.'
    m_Metadata:
      m_Items: []
  - m_Id: 14619625989701632
    m_Localized: 'Cost: 1 Roll per roll'
    m_Metadata:
      m_Items: []
  - m_Id: 14619625989701633
    m_Localized: " \xD7 {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 14619625989701634
    m_Localized: 'No combo: ATK + highest kept die'
    m_Metadata:
