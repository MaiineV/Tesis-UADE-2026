    m_Metadata:
      m_Items: []
  - m_Id: 12996722096635904
    m_Localized: 'Reroll: rerolls selected dice'
    m_Metadata:
      m_Items: []
  - m_Id: 12996722146967552
    m_Localized: 'Reroll: keeps selected dice'
