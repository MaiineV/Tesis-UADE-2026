    m_Localized: This tile improves your next movement.
    m_Metadata:
      m_Items: []
  - m_Id: 14364254620450823
    m_Localized: Strength
    m_Metadata:
      m_Items: []
  - m_Id: 14364254620450824
    m_Localized: Your offensive combos deal bonus damage while you stay here.
    m_Metadata:
      m_Items: []
