  - m_Id: 9716852768735244
    m_Localized: Double Pair deals +20 damage.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735245
    m_Localized: Champion's Cup
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735246
    m_Localized: The Generala deals +50 damage.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735247
    m_Localized: Reinforced Plate
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735248
    m_Localized: +2 max health.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735249
    m_Localized: Noble Crown
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735250
    m_Localized: Each Full House restores 5 HP.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735251
    m_Localized: The Selfish One
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735252
    m_Localized: The more gold you have, the more damage you deal.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735253
    m_Localized: Imperial Shield
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735254
    m_Localized: Each Poker grants +2 shield.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735255
    m_Localized: Fire Sword
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735256
    m_Localized: The Brute Force combo deals +35 damage.
    m_Metadata:
      m_Items: []
