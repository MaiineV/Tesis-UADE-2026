    m_Metadata:
      m_Items: []
  - m_Id: 9716852756152320
    m_Localized: Reflection Amulet
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735232
    m_Localized: When you take damage, deal 10 damage back to the enemy that hit
      you.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735233
    m_Localized: Royal Feast
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735234
    m_Localized: Full Houses deal +30 damage.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735235
    m_Localized: Blessing of Fate
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735236
    m_Localized: Each Generala heals 15 HP.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735237
    m_Localized: Merchant's Pouch
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735238
    m_Localized: Each Double Pair grants +5 gold.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735239
    m_Localized: Climber's Boots
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735240
    m_Localized: The Ladder deals +25 damage.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735241
