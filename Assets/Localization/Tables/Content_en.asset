    m_Metadata:
      m_Items: []
  - m_Id: 5318351024133
    m_Localized: Straight
    m_Metadata:
      m_Items: []
  - m_Id: 5318351024134
    m_Localized: Dice in a run
    m_Metadata:
      m_Items: []
  - m_Id: 5318351024135
    m_Localized: Brute Force
    m_Metadata:
      m_Items: []
  - m_Id: 5318351024136
    m_Localized: 'Sums the values of all dice that landed in the upper half of their
      own range (d6: 4-6, d8: 5-8, d12: 7-12).'
    m_Metadata:
      m_Items: []
  - m_Id: 5318351024137
    m_Localized: Full House
    m_Metadata:
      m_Items: []
  - m_Id: 5318351024138
    m_Localized: 2 dice of one value and 3 of another
    m_Metadata:
      m_Items: []
  - m_Id: 5318351024139
    m_Localized: Generala
    m_Metadata:
      m_Items: []
  - m_Id: 5318351024140
    m_Localized: 5 dice of the same value
    m_Metadata:
      m_Items: []
  - m_Id: 5318351024141
    m_Localized: Higher Number
    m_Metadata:
      m_Items: []
  - m_Id: 5318351024142
    m_Localized: Highest die
    m_Metadata:
      m_Items: []
  - m_Id: 5318351024143
    m_Localized: Pair
    m_Metadata:
