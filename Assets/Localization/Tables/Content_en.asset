    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735265
    m_Localized: Blood Ritual
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735266
    m_Localized: Each Trio restores 1 HP.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735267
    m_Localized: Steel Kneepads
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735268
    m_Localized: You start each combat with +3 shield.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735269
    m_Localized: Vital Talisman
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735270
    m_Localized: Restore 1 HP when combat starts.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735271
    m_Localized: Legendary Treasure
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735272
    m_Localized: Each Generala grants +30 gold.
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735273
    m_Localized: Clan Totem
    m_Metadata:
      m_Items: []
  - m_Id: 9716852768735274
    m_Localized: Trios deal +30 damage.
    m_Metadata:
