  - m_Id: 17988676544020480
    m_Localized: Jackpot
    m_Metadata:
      m_Items: []
  - m_Id: 17988676606935040
    m_Localized: +5 damage for each die showing a 7 in your attack.
    m_Metadata:
      m_Items: []
  - m_Id: 17988679589085184
    m_Localized: Last Card
    m_Metadata:
      m_Items: []
  - m_Id: 17988679589085185
