# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# By default unity supports Blender asset imports, *.blend1 blender files do not need to be commited to version control.
*.blend1
*.blend1.meta

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Orchestration artifacts — per-worktree plan files should NOT be committed
# (each Foundation/System/Feature worktree writes its own plan.md at the repo root)
/plan.md

# Obsidian volatile workspace files
Rollgeon/.obsidian/workspace.json
Rollgeon/.obsidian/core-plugins.json

# Performance Testing package leftovers — los escribe el preprocess de la build en
# Assets/Resources/ y los borra el postprocess; si la build falla quedan colgados.
/[Aa]ssets/[Rr]esources/PerformanceTestRunInfo.json*
/[Aa]ssets/[Rr]esources/PerformanceTestRunSettings.json*

# Crash dumps de Git Bash en Windows
*.stackdump
/video/

# Tooling local (instalación por máquina, no va al repo)
/.mcp.json
/Packages/com.gamelovers.mcp-unity/

# Estado del IDE
.idea/.idea.Tesis-UADE-2026/.idea/workspace.xml
.idea/.idea.Tesis-UADE-2026/.idea/copilot.data.migration.agent.xml

# Docs de trabajo locales
/docs/setup/tutorial.md
/Rollgeon/05-Entities/TUTORIAL_Boss3_DirectorGeneral.md

# Mockups de referencia (no se versionan)
/Seleccion_personaje.jpeg
/SELECCION_DADOS.jpeg
/class_selection_capture.png
/build_selection_capture.png

# Corridas del boss bot (tools/playtest/run-boss-bot.ps1): capturas + logs por corrida.
# Fuera de Assets/ a proposito — ahi Unity importaria cada PNG y generaria .meta.
/PlaytestRuns/

# Capturas sueltas que caen dentro de Assets/. Misma razon que /PlaytestRuns/, pero acá
# Unity ya las importó y les generó .meta: se ignoran las dos cosas.
/Assets/Screenshots/
/Assets/Screenshots.meta

# Símbolos de debug del External Dependency Manager de Google. El plugin no vive en el
# repo (ni una DLL trackeada) — esto es sólo lo que su VersionHandler deja tirado.
/Assets/MobileDependencyResolver/
/Assets/MobileDependencyResolver.meta

# steamcmd local (Tools/steamcmd). Nunca commitear: además de binarios pesados,
# steamcmd cachea ahí el sentry/config de la cuenta de Steam tras el login.
/Tools/steamcmd/

# Notas que los subagentes se dejan entre corridas. Son per-checkout y no describen
# el juego: mergearlas seria mezclar el scratch de dos maquinas distintas.
/.claude/agent-memory/

# Secretos locales. `.env` guarda el PAT de DocsApp (API del GDD) — nunca se commitea.
# El template sin token vive en docs/setup/docsapp-api.md.
/.env
/.env.*
# Alternativa al .env para agents que no pueden tocar archivos `.env*`:
# `.secrets/docsapp.env`, mismo formato. docsapp.ps1 lo carga como fallback.
/.secrets/
